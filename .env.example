# 로컬 bootRun과 docker compose가 함께 쓰는 DB 접속 정보 (properties 형식, 커밋 금지)
# docker compose로 띄우면 docker-compose.override.yml이 DB_URL 호스트를 host.docker.internal로 덮어쓴다
DB_URL=jdbc:mysql://localhost:3306/mashup2
DB_USERNAME=
DB_PASSWORD=

# Open Exchange Rates 앱 키 (https://openexchangerates.org). 비우면 환율 갱신을 건너뛴다
OPEN_EXCHANGE_RATES_APP_ID=
